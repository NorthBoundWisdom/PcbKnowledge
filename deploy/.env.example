# Non-secret local overrides. Copy to an untracked root .env only when needed.
PCBKNOWLEDGE_HTTP_PORT=8080
PCBKNOWLEDGE_KEYCLOAK_PORT=8081
PCBKNOWLEDGE_GRAFANA_PORT=3000
PCBKNOWLEDGE_PROMETHEUS_PORT=9090
PCBKNOWLEDGE_S3_PORT=8333

# Development defaults are explicit tags. Production must use repository@sha256:digest.
POSTGRES_IMAGE=pgvector/pgvector:pg18
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:3.85
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.4.7
CADDY_IMAGE=caddy:2.10.2-alpine
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.139.0
PROMETHEUS_IMAGE=prom/prometheus:v3.7.3
GRAFANA_IMAGE=grafana/grafana:12.2.0
NGINX_IMAGE=nginx:1.29.2-alpine
PYTHON_IMAGE=python:3.14-slim-bookworm
UV_IMAGE=ghcr.io/astral-sh/uv:0.12.3
NODE_IMAGE=node:24.11.1-alpine
