{
  "realm": "pcbknowledge",
  "enabled": true,
  "displayName": "PcbKnowledge",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      { "name": "DATA_CURATOR", "description": "Prepare and verify evidence candidates" },
      { "name": "DOMAIN_REVIEWER", "description": "Approve high-risk engineering facts" },
      { "name": "KNOWLEDGE_ADMIN", "description": "Administer knowledge policy and access" },
      { "name": "AUDITOR", "description": "Read append-only audit evidence" },
      { "name": "AGENT_SERVICE", "description": "Call typed APIs as a non-human service" }
    ]
  },
  "clients": [
    {
      "clientId": "pcbknowledge-api",
      "name": "PcbKnowledge API audience",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "pcbknowledge-curator-web",
      "name": "PcbKnowledge Curator Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:8080",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:8080/auth/callback",
        "http://localhost:5173/auth/callback",
        "http://127.0.0.1:4173/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://localhost:5173",
        "http://127.0.0.1:4173"
      ],
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "basic", "email"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/auth/logout/callback##http://localhost:5173/auth/logout/callback##http://127.0.0.1:4173/auth/logout/callback"
      },
      "protocolMappers": [
        {
          "name": "pcbknowledge-human-subject-kind",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "pcbknowledge_subject_kind",
            "claim.value": "HUMAN",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "pcbknowledge-human-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "pcbknowledge-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "pcbknowledge-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "pcbknowledge-agent-service",
      "name": "PcbKnowledge Agent Service",
      "enabled": true,
      "bearerOnly": false,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "__PCBKNOWLEDGE_AGENT_SERVICE_SECRET__",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["roles"],
      "protocolMappers": [
        {
          "name": "pcbknowledge-service-subject-kind",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "pcbknowledge_subject_kind",
            "claim.value": "SERVICE_ACCOUNT",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "pcbknowledge-service-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "pcbknowledge-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "pcbknowledge-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "scopeMappings": [
    {
      "client": "pcbknowledge-curator-web",
      "roles": ["DATA_CURATOR", "DOMAIN_REVIEWER", "KNOWLEDGE_ADMIN", "AUDITOR"]
    },
    {
      "client": "pcbknowledge-agent-service",
      "roles": ["AGENT_SERVICE"]
    }
  ],
  "users": [
    {
      "username": "service-account-pcbknowledge-agent-service",
      "enabled": true,
      "serviceAccountClientId": "pcbknowledge-agent-service",
      "realmRoles": ["AGENT_SERVICE"]
    }
  ]
}
