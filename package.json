{
  "name": "pcbknowledge",
  "version": "0.0.0",
  "private": true,
  "description": "Evidence-first PCB engineering knowledge platform workspace",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @pcbknowledge/curator-web build",
    "check:generated": "node packages/contracts/scripts/generate-openapi-client.mjs --check",
    "dev:web": "pnpm --filter @pcbknowledge/curator-web dev",
    "generate:api": "node packages/contracts/scripts/generate-openapi-client.mjs",
    "lint": "eslint apps/curator-web packages/ui-kit packages/contracts/scripts/generate-openapi-client.mjs --max-warnings=0",
    "test": "pnpm --filter @pcbknowledge/curator-web test",
    "test:e2e": "pnpm --filter @pcbknowledge/curator-web test:e2e",
    "typecheck": "pnpm --filter @pcbknowledge/ui-kit typecheck && pnpm --filter @pcbknowledge/curator-web typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.13",
    "eslint": "10.0.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0"
  }
}
