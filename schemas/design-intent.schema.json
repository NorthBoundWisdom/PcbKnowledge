{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-intent.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "pcbknowledge.design_intent.v2"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "brief_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "bundle_commit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[0-9a-f]{40}$"
    },
    "block_graph_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[0-9a-f]{64}$"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(source|part|package|block|rule|fab_profile):[a-z0-9][a-z0-9/_-]*$",
        "maxLength": 256
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "EXPANDED",
        "REFUSED"
      ]
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "part": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^part:[a-z0-9][a-z0-9/_-]*$"
          },
          "package": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^package:[a-z0-9][a-z0-9/_-]*$"
          },
          "footprint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "mount_type": {
            "enum": [
              "SMT",
              "THT",
              "MECHANICAL"
            ]
          },
          "assembly_method": {
            "enum": [
              "SMT_ASSEMBLY",
              "THT_ASSEMBLY",
              "HAND_SOLDER",
              "MECHANICAL"
            ]
          }
        },
        "required": [
          "ref",
          "part",
          "package",
          "footprint"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "nets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "pins": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "pin": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "ref",
                "pin"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "class": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "name",
          "pins",
          "class"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "bom": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^part:[a-z0-9][a-z0-9/_-]*$"
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "mount_type": {
            "enum": [
              "SMT",
              "THT",
              "MECHANICAL"
            ]
          },
          "assembly_method": {
            "enum": [
              "SMT_ASSEMBLY",
              "THT_ASSEMBLY",
              "HAND_SOLDER",
              "MECHANICAL"
            ]
          }
        },
        "required": [
          "part",
          "refs",
          "quantity"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "layout": {
      "type": "array",
      "items": {
        "$ref": "layout-constraint.schema.json"
      },
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "unconnected_state": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "evidence.schema.json"
                },
                "minItems": 1
              }
            },
            "required": [
              "state",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "result"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "verification": {
      "enum": [
        "DRAFT",
        "AGENT_VERIFIED",
        "HUMAN_VERIFIED"
      ]
    },
    "refusals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "enum": [
              "UNKNOWN_INPUT",
              "MISSING_RECORD",
              "UNVERIFIED_RECORD",
              "UNSATISFIED_SELECTION",
              "UNCONNECTED_PIN",
              "CHECK_FAILED",
              "INVALID_REFERENCE"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "queries": {
            "type": "array",
            "items": {
              "enum": [
                "Q1",
                "Q2",
                "Q3",
                "Q4",
                "Q5",
                "Q6",
                "Q7",
                "Q8",
                "Q9",
                "Q10",
                "Q11",
                "Q12"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "code",
          "path",
          "reason",
          "queries"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      },
      "minItems": 0
    },
    "fab_profile": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^fab_profile:[a-z0-9][a-z0-9/_-]*$",
          "maxLength": 256
        },
        {
          "$ref": "unknown.schema.json"
        }
      ]
    },
    "mechanical": {
      "type": "object",
      "properties": {
        "outline_envelope": {
          "type": "object",
          "properties": {
            "shape": {
              "const": "RECTANGLE"
            },
            "max_length": {
              "oneOf": [
                {
                  "$ref": "quantity.schema.json"
                },
                {
                  "$ref": "unknown.schema.json"
                }
              ]
            },
            "max_width": {
              "oneOf": [
                {
                  "$ref": "quantity.schema.json"
                },
                {
                  "$ref": "unknown.schema.json"
                }
              ]
            }
          },
          "required": [
            "shape",
            "max_length",
            "max_width"
          ],
          "additionalProperties": false
        },
        "height_limit": {
          "oneOf": [
            {
              "$ref": "quantity.schema.json"
            },
            {
              "$ref": "unknown.schema.json"
            },
            {
              "$ref": "quantity.schema.json#/$defs/unconstrained"
            }
          ]
        },
        "mounting": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "fastener": {
                "const": "M3"
              }
            },
            "required": [
              "ref",
              "fastener"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "edge_interfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true
        }
      },
      "required": [
        "outline_envelope",
        "height_limit",
        "mounting",
        "edge_interfaces"
      ],
      "additionalProperties": false
    },
    "manufacturing": {
      "type": "object",
      "properties": {
        "layers": {
          "oneOf": [
            {
              "const": 2
            },
            {
              "$ref": "unknown.schema.json"
            }
          ]
        },
        "thickness": {
          "oneOf": [
            {
              "$ref": "quantity.schema.json"
            },
            {
              "$ref": "unknown.schema.json"
            }
          ]
        },
        "copper_requirement": {
          "oneOf": [
            {
              "const": "ONE_OZ_NOMINAL"
            },
            {
              "$ref": "unknown.schema.json"
            }
          ]
        },
        "assembly_side": {
          "oneOf": [
            {
              "const": "TOP"
            },
            {
              "$ref": "unknown.schema.json"
            }
          ]
        }
      },
      "required": [
        "layers",
        "thickness",
        "copper_requirement",
        "assembly_side"
      ],
      "additionalProperties": false
    },
    "pin_configurations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "pin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "mode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "initial_state": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "evidence.schema.json"
            },
            "minItems": 1
          }
        },
        "required": [
          "ref",
          "pin",
          "mode",
          "initial_state",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "external_loads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "block": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "local_connector": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "connector": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "supply_pin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "return_pin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "provider": {
            "type": "object",
            "properties": {
              "block": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "local_component": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "pin": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "port": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "block",
              "local_component",
              "ref",
              "pin",
              "port"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "block",
          "local_connector",
          "connector",
          "supply_pin",
          "return_pin",
          "provider"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "bringup": {
      "$ref": "#/$defs/bringup"
    },
    "single_supply_returns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "component": {
            "type": "string",
            "minLength": 1
          },
          "positive_pin": {
            "type": "string",
            "minLength": 1
          },
          "negative_pin": {
            "type": "string",
            "minLength": 1
          },
          "supply_net": {
            "type": "string",
            "minLength": 1
          },
          "return_net": {
            "type": "string",
            "minLength": 1
          },
          "capacitor": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "evidence.schema.json"
            }
          }
        },
        "required": [
          "component",
          "positive_pin",
          "negative_pin",
          "supply_net",
          "return_net",
          "capacitor",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "id",
    "brief_id",
    "bundle_commit",
    "block_graph_sha256",
    "status",
    "dependencies",
    "components",
    "nets",
    "bom",
    "layout",
    "checks",
    "verification",
    "refusals",
    "evidence",
    "fab_profile",
    "mechanical",
    "manufacturing"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "status": {
          "const": "EXPANDED"
        },
        "components": {
          "minItems": 1,
          "items": {
            "required": [
              "mount_type",
              "assembly_method"
            ]
          }
        },
        "nets": {
          "minItems": 1
        },
        "bom": {
          "minItems": 1,
          "items": {
            "required": [
              "mount_type",
              "assembly_method"
            ]
          }
        },
        "verification": {
          "enum": [
            "AGENT_VERIFIED",
            "HUMAN_VERIFIED"
          ]
        },
        "refusals": {
          "maxItems": 0
        },
        "checks": {
          "items": {
            "properties": {
              "result": {
                "const": "PASS"
              }
            }
          }
        },
        "fab_profile": {
          "type": "string",
          "pattern": "^fab_profile:[a-z0-9][a-z0-9/_-]*$",
          "maxLength": 256
        },
        "mechanical": {
          "properties": {
            "outline_envelope": {
              "properties": {
                "max_length": {
                  "$ref": "quantity.schema.json"
                },
                "max_width": {
                  "$ref": "quantity.schema.json"
                }
              }
            },
            "height_limit": {
              "oneOf": [
                {
                  "$ref": "quantity.schema.json"
                },
                {
                  "$ref": "quantity.schema.json#/$defs/unconstrained"
                }
              ]
            },
            "mounting": {
              "minItems": 1
            }
          }
        },
        "manufacturing": {
          "properties": {
            "layers": {
              "const": 2
            },
            "thickness": {
              "$ref": "quantity.schema.json"
            },
            "copper_requirement": {
              "const": "ONE_OZ_NOMINAL"
            },
            "assembly_side": {
              "const": "TOP"
            }
          }
        }
      }
    },
    {
      "properties": {
        "status": {
          "const": "REFUSED"
        },
        "refusals": {
          "minItems": 1
        }
      }
    }
  ],
  "$defs": {
    "bringup": {
      "type": "object",
      "properties": {
        "rails": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9_]+\\.pin:[A-Za-z0-9_]+$"
              },
              "reference_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9_]+\\.pin:[A-Za-z0-9_]+$"
              },
              "expected_voltage": {
                "allOf": [
                  {
                    "$ref": "quantity.schema.json"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "const": "V"
                      },
                      "basis": {
                        "const": "ENGINEERING_DEFAULT"
                      },
                      "conditions": {
                        "type": "object",
                        "minProperties": 1
                      }
                    },
                    "required": [
                      "min",
                      "max",
                      "note",
                      "conditions"
                    ]
                  }
                ]
              },
              "prerequisites": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              },
              "supporting_evidence": {
                "type": "array",
                "items": {
                  "$ref": "evidence.schema.json"
                },
                "uniqueItems": true
              },
              "waveform": {
                "type": "object",
                "properties": {
                  "protocol": {
                    "const": "TPS5430_PH_D91"
                  },
                  "basis": {
                    "const": "ENGINEERING_DEFAULT"
                  },
                  "input_at": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[A-Za-z0-9_]+\\.pin:[A-Za-z0-9_]+$"
                  },
                  "probe": {
                    "const": "ACTIVE_DIFFERENTIAL"
                  },
                  "processing": {
                    "const": "RAW_NO_AVERAGING_NO_FILTER"
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "input_voltage": {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "const": "V"
                      },
                      "basis": {
                        "const": "ENGINEERING_DEFAULT"
                      },
                      "min": {
                        "type": "number"
                      },
                      "max": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "unit",
                      "basis",
                      "min",
                      "max"
                    ],
                    "additionalProperties": false
                  },
                  "high_offset": {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "const": "V"
                      },
                      "basis": {
                        "const": "ENGINEERING_DEFAULT"
                      },
                      "min": {
                        "type": "number"
                      },
                      "max": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "unit",
                      "basis",
                      "min",
                      "max"
                    ],
                    "additionalProperties": false
                  },
                  "low_level": {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "const": "V"
                      },
                      "basis": {
                        "const": "ENGINEERING_DEFAULT"
                      },
                      "min": {
                        "type": "number"
                      },
                      "max": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "unit",
                      "basis",
                      "min",
                      "max"
                    ],
                    "additionalProperties": false
                  },
                  "positive_peak_offset": {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "const": "V"
                      },
                      "basis": {
                        "const": "ENGINEERING_DEFAULT"
                      },
                      "max": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "unit",
                      "basis",
                      "max"
                    ],
                    "additionalProperties": false
                  },
                  "positive_peak": {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "const": "V"
                      },
                      "basis": {
                        "const": "ENGINEERING_DEFAULT"
                      },
                      "max": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "unit",
                      "basis",
                      "max"
                    ],
                    "additionalProperties": false
                  },
                  "negative_peak": {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "const": "V"
                      },
                      "basis": {
                        "const": "ENGINEERING_DEFAULT"
                      },
                      "min": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "unit",
                      "basis",
                      "min"
                    ],
                    "additionalProperties": false
                  },
                  "positive_excursion_threshold": {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "const": "V"
                      },
                      "basis": {
                        "const": "ENGINEERING_DEFAULT"
                      },
                      "min": {
                        "type": "number"
                      },
                      "max": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "unit",
                      "basis",
                      "min",
                      "max"
                    ],
                    "additionalProperties": false
                  },
                  "negative_excursion_threshold": {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "const": "V"
                      },
                      "basis": {
                        "const": "ENGINEERING_DEFAULT"
                      },
                      "min": {
                        "type": "number"
                      },
                      "max": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "unit",
                      "basis",
                      "min",
                      "max"
                    ],
                    "additionalProperties": false
                  },
                  "positive_excursion_duration": {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "const": "s"
                      },
                      "basis": {
                        "const": "ENGINEERING_DEFAULT"
                      },
                      "max": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "unit",
                      "basis",
                      "max"
                    ],
                    "additionalProperties": false
                  },
                  "negative_excursion_duration": {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "const": "s"
                      },
                      "basis": {
                        "const": "ENGINEERING_DEFAULT"
                      },
                      "max": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "unit",
                      "basis",
                      "max"
                    ],
                    "additionalProperties": false
                  },
                  "edge_time": {
                    "type": "object",
                    "properties": {
                      "unit": {
                        "const": "s"
                      },
                      "basis": {
                        "const": "ENGINEERING_DEFAULT"
                      },
                      "max": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "unit",
                      "basis",
                      "max"
                    ],
