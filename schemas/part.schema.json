{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "part.schema.json",
  "type": "object",
  "properties": {
    "schema": {"const": "pcbknowledge.part.v2"},
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^part:[a-z0-9][a-z0-9/_-]*$"},
    "verification": {"$ref": "envelope.schema.json#/$defs/verification"},
    "provenance": {"$ref": "envelope.schema.json#/$defs/provenance"},
    "manufacturer": {"type": "string", "minLength": 1, "maxLength": 256},
    "mpn": {"type": "string", "minLength": 1, "maxLength": 256},
    "package": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^package:[a-z0-9][a-z0-9/_-]*$"},
    "roles": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 256},
      "minItems": 1,
      "uniqueItems": true
    },
    "pins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "number": {"type": "string", "minLength": 1, "maxLength": 256},
          "name": {"type": "string", "minLength": 1, "maxLength": 256},
          "type": {"type": "string", "minLength": 1, "maxLength": 256},
          "same_net_as": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "required": ["number", "name", "type"],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "parameters": {"$ref": "parameters.schema.json"},
    "pin_evidence": {
      "type": "object",
      "properties": {
        "basis": {"const": "DATASHEET"},
        "source": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^source:[a-z0-9][a-z0-9/_-]*$"},
        "page": {"type": "integer", "minimum": 1}
      },
      "required": ["basis", "source", "page"],
      "additionalProperties": false
    },
    "sourcing": {
      "type": "object",
      "properties": {"lifecycle": {"enum": ["ACTIVE", "NRND", "OBSOLETE", "UNKNOWN"]}},
      "required": ["lifecycle"],
      "additionalProperties": false
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^rule:[a-z0-9][a-z0-9/_-]*$"},
          "replace_with": {"enum": ["block-provided"]}
        },
        "required": ["rule", "replace_with"],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "identity_evidence": {"$ref": "evidence.schema.json"}
  },
  "required": [
    "schema",
    "id",
    "verification",
    "provenance",
    "manufacturer",
    "mpn",
    "package",
    "roles",
    "pins",
    "parameters",
    "pin_evidence",
    "sourcing",
    "identity_evidence"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "oneOf": [
        {"properties": {"verification": {"const": "DRAFT"}}},
        {
          "properties": {
            "verification": {"enum": ["AGENT_VERIFIED", "HUMAN_VERIFIED"]},
            "provenance": {"properties": {"verified_by": {"minItems": 1}}}
          }
        }
      ]
    }
  ]
}
