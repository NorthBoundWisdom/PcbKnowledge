{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "part.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "pcbknowledge.part.v2"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^part:[a-z0-9][a-z0-9/_-]*$"
    },
    "verification": {
      "$ref": "envelope.schema.json#/$defs/verification"
    },
    "provenance": {
      "$ref": "envelope.schema.json#/$defs/provenance"
    },
    "manufacturer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "mpn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "package": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^package:[a-z0-9][a-z0-9/_-]*$"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "pins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "number": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "same_net_as": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "functions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "$ref": "evidence.schema.json"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "name",
                "evidence"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "unconnected_state": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "evidence.schema.json"
                },
                "minItems": 1
              }
            },
            "required": [
              "state",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "number",
          "name",
          "type"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "parameters": {
      "$ref": "parameters.schema.json"
    },
    "pin_evidence": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "basis": {
              "enum": [
                "DATASHEET",
                "STANDARD_CONVENTION"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^source:[a-z0-9][a-z0-9/_-]*$"
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "convention": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": [
            "basis",
            "source",
            "page"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "oneOf": [
                {
                  "properties": {
                    "basis": {
                      "const": "DATASHEET"
                    }
                  }
                },
                {
                  "properties": {
                    "basis": {
                      "const": "STANDARD_CONVENTION"
                    }
                  },
                  "required": [
                    "convention"
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "basis": {
              "const": "ENGINEERING_DEFAULT"
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "basis",
            "note"
          ],
          "additionalProperties": false
        }
      ]
    },
    "sourcing": {
      "type": "object",
      "properties": {
        "lifecycle": {
          "enum": [
            "ACTIVE",
            "NRND",
            "OBSOLETE",
            "UNKNOWN"
          ]
        }
      },
      "required": [
        "lifecycle"
      ],
      "additionalProperties": false
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^rule:[a-z0-9][a-z0-9/_-]*$"
          },
          "replace_with": {
            "enum": [
              "block-provided"
            ]
          }
        },
        "required": [
          "rule",
          "replace_with"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "identity_evidence": {
      "oneOf": [
        {
          "$ref": "evidence.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "basis": {
              "const": "ENGINEERING_DEFAULT"
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "basis",
            "note"
          ],
          "additionalProperties": false
        }
      ]
    },
    "bootstrap_supplies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "bootstrap_pin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "switch_pin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "supply_pin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "ground_pin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "const": "FLOATING_BOOTSTRAP_SUPPLY"
          },
          "charge_path": {
            "const": "INTERNAL_REGULATOR_DIODE"
          },
          "capacitor_role": {
            "const": "capacitor.ceramic"
          },
          "capacitance_nominal": {
            "$ref": "quantity.schema.json"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "evidence.schema.json"
            }
          }
        },
        "required": [
          "bootstrap_pin",
          "switch_pin",
          "supply_pin",
          "ground_pin",
          "kind",
          "charge_path",
          "capacitor_role",
          "capacitance_nominal",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "single_supply_return": {
      "type": "object",
      "properties": {
        "positive_pin": {
          "type": "string",
          "minLength": 1
        },
        "negative_pin": {
          "type": "string",
          "minLength": 1
        },
        "capacitance_nominal": {
          "$ref": "quantity.schema.json"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "evidence.schema.json"
          }
        }
      },
      "required": [
        "positive_pin",
        "negative_pin",
        "capacitance_nominal",
        "evidence"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "id",
    "verification",
    "provenance",
    "manufacturer",
    "mpn",
    "package",
    "roles",
    "pins",
    "parameters",
    "pin_evidence",
    "sourcing",
    "identity_evidence"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "verification": {
              "const": "DRAFT"
            }
          }
        },
        {
          "properties": {
            "verification": {
              "enum": [
                "AGENT_VERIFIED",
                "HUMAN_VERIFIED"
              ]
            },
            "provenance": {
              "properties": {
                "verified_by": {
                  "minItems": 1
                }
              }
            }
          }
        }
      ]
    }
  ]
}
