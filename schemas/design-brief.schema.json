{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-brief.schema.json",
  "title": "Synthetic golden design brief",
  "type": "object",
  "properties": {
    "schema": {
      "const": "pcbknowledge.design-brief.v2"
    },
    "id": {
      "enum": [
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G1V1",
        "G1V2",
        "N1",
        "N2",
        "N3",
        "N4"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "DRAFT"
    },
    "origin": {
      "const": "SYNTHETIC"
    },
    "owner_decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^D[1-9][0-9]*$"
      },
      "minItems": 0
    },
    "power": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "voltage": {
                "oneOf": [
                  {
                    "$ref": "quantity.schema.json"
                  },
                  {
                    "$ref": "unknown.schema.json"
                  }
                ]
              },
              "current_budget": {
                "oneOf": [
                  {
                    "$ref": "quantity.schema.json"
                  },
                  {
                    "$ref": "unknown.schema.json"
                  }
                ]
              },
              "function": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "description",
              "voltage",
              "current_budget"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "rails": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "voltage": {
                "oneOf": [
                  {
                    "$ref": "quantity.schema.json"
                  },
                  {
                    "$ref": "unknown.schema.json"
                  }
                ]
              },
              "current_budget": {
                "oneOf": [
                  {
                    "$ref": "quantity.schema.json"
                  },
                  {
                    "$ref": "unknown.schema.json"
                  }
                ]
              },
              "function": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "voltage",
              "current_budget"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "sources",
        "rails"
      ],
      "additionalProperties": false
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "part_preferences": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "parameters": {
            "$ref": "parameters.schema.json"
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "package_family": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "package_role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "id",
          "description",
          "count",
          "part_preferences",
          "requirements",
          "parameters"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "oneOf": [
              {
                "required": [
                  "package_family",
                  "package_role"
                ]
              },
              {
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "package_family"
                      ]
                    },
                    {
                      "required": [
                        "package_role"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "minItems": 1
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "signals": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "voltage": {
            "oneOf": [
              {
                "$ref": "quantity.schema.json"
              },
              {
                "$ref": "unknown.schema.json"
              }
            ]
          },
          "current_limit": {
            "oneOf": [
              {
                "$ref": "quantity.schema.json"
              },
              {
                "$ref": "unknown.schema.json"
              }
            ]
          }
        },
        "required": [
          "id",
          "description",
          "signals",
          "voltage",
          "current_limit"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "mechanical": {
      "type": "object",
      "properties": {
        "length": {
          "oneOf": [
            {
              "$ref": "quantity.schema.json"
            },
            {
              "$ref": "unknown.schema.json"
            }
          ]
        },
        "width": {
          "oneOf": [
            {
              "$ref": "quantity.schema.json"
            },
            {
              "$ref": "unknown.schema.json"
            }
          ]
        },
        "mounting": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "drill": {
                "oneOf": [
                  {
                    "$ref": "quantity.schema.json"
                  },
                  {
                    "$ref": "unknown.schema.json"
                  }
                ]
              },
              "keepout_diameter": {
                "oneOf": [
                  {
                    "$ref": "quantity.schema.json"
                  },
                  {
                    "$ref": "unknown.schema.json"
                  }
                ]
              },
              "edge_offset": {
                "oneOf": [
                  {
                    "$ref": "quantity.schema.json"
                  },
                  {
                    "$ref": "unknown.schema.json"
                  }
                ]
              }
            },
            "required": [
              "id",
              "description"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "edge_interfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "height": {
          "oneOf": [
            {
              "$ref": "quantity.schema.json"
            },
            {
              "$ref": "unknown.schema.json"
            },
            {
              "$ref": "quantity.schema.json#/$defs/unconstrained"
            }
          ]
        }
      },
      "required": [
        "length",
        "width",
        "mounting",
        "edge_interfaces",
        "height"
      ],
      "additionalProperties": false
    },
    "manufacturing": {
      "type": "object",
      "properties": {
        "profile": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "$ref": "unknown.schema.json"
            }
          ]
        },
        "layers": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "$ref": "unknown.schema.json"
            }
          ]
        },
        "thickness": {
          "oneOf": [
            {
              "$ref": "quantity.schema.json"
            },
            {
              "$ref": "unknown.schema.json"
            }
          ]
        },
        "copper": {
          "enum": [
            "ONE_OZ"
          ]
        },
        "assembly": {
          "enum": [
            "SINGLE_SIDE_TOP"
          ]
        },
        "preferred_passives": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "profile",
        "layers",
        "thickness",
        "copper",
        "assembly",
        "preferred_passives"
      ],
      "additionalProperties": false
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "enum": [
              "A1",
              "A2",
              "A3",
              "A4",
              "A5",
              "A6"
            ]
          },
          "owner": {
            "enum": [
              "PcbKnowledge",
              "PcbAtlas",
              "Owner"
            ]
          },
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "NOT_RUN"
          }
        },
        "required": [
          "level",
          "owner",
          "criterion",
          "status"
        ],
        "additionalProperties": false
      },
      "minItems": 6
    },
    "expected_refusal": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "UNSATISFIED_SELECTION",
            "CHECK_FAILED"
          ]
        },
        "requirement": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      },
      "required": [
        "code",
        "requirement"
      ],
      "additionalProperties": false
    },
    "electrical_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 256
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "function": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "port": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "function",
                "port"
              ],
              "additionalProperties": false
            },
            "minItems": 2,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "endpoints"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "id",
    "title",
    "summary",
    "status",
    "origin",
    "owner_decisions",
    "power",
    "functions",
    "interfaces",
    "mechanical",
    "manufacturing",
    "constraints",
    "acceptance"
  ],
  "additionalProperties": false
}
