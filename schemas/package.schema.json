{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "package.schema.json",
  "type": "object",
  "properties": {
    "schema": {"const": "pcbknowledge.package.v2"},
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^package:[a-z0-9][a-z0-9/_-]*$"},
    "verification": {"$ref": "envelope.schema.json#/$defs/verification"},
    "provenance": {"$ref": "envelope.schema.json#/$defs/provenance"},
    "family": {"type": "string", "minLength": 1, "maxLength": 256},
    "body": {
      "type": "object",
      "properties": {
        "length": {"oneOf": [{"$ref": "quantity.schema.json"}, {"$ref": "unknown.schema.json"}]},
        "width": {"oneOf": [{"$ref": "quantity.schema.json"}, {"$ref": "unknown.schema.json"}]},
        "height": {"oneOf": [{"$ref": "quantity.schema.json"}, {"$ref": "unknown.schema.json"}]}
      },
      "required": ["length", "width", "height"],
      "additionalProperties": false
    },
    "footprint": {
      "type": "object",
      "properties": {
        "mode": {"type": "string", "minLength": 1, "maxLength": 256},
        "pads": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "number": {"type": "string", "minLength": 1, "maxLength": 256},
              "kind": {"enum": ["SMD", "THROUGH_HOLE", "MECHANICAL"]},
              "shape": {"enum": ["RECT", "ROUND", "OVAL"]},
              "x": {"oneOf": [{"$ref": "quantity.schema.json"}, {"$ref": "unknown.schema.json"}]},
              "y": {"oneOf": [{"$ref": "quantity.schema.json"}, {"$ref": "unknown.schema.json"}]},
              "width": {"oneOf": [{"$ref": "quantity.schema.json"}, {"$ref": "unknown.schema.json"}]},
              "height": {"oneOf": [{"$ref": "quantity.schema.json"}, {"$ref": "unknown.schema.json"}]},
              "drill": {"oneOf": [{"$ref": "quantity.schema.json"}, {"$ref": "unknown.schema.json"}]},
              "rotation": {"oneOf": [{"$ref": "quantity.schema.json"}, {"$ref": "unknown.schema.json"}]}
            },
            "required": ["number", "kind", "shape", "x", "y", "width", "height", "rotation"],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": ["mode", "pads"],
      "additionalProperties": false
    },
    "pin1": {"type": "string", "minLength": 1, "maxLength": 256},
    "courtyard_margin": {"oneOf": [{"$ref": "quantity.schema.json"}, {"$ref": "unknown.schema.json"}]},
    "evidence": {"type": "array", "items": {"$ref": "evidence.schema.json"}, "minItems": 1}
  },
  "required": [
    "schema",
    "id",
    "verification",
    "provenance",
    "family",
    "body",
    "footprint",
    "pin1",
    "courtyard_margin",
    "evidence"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "oneOf": [
        {"properties": {"verification": {"const": "DRAFT"}}},
        {
          "properties": {
            "verification": {"enum": ["AGENT_VERIFIED", "HUMAN_VERIFIED"]},
            "provenance": {"properties": {"verified_by": {"minItems": 1}}}
          }
        }
      ]
    }
  ]
}
