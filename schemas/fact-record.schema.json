{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcbknowledge.local/schemas/fact-record.schema.json",
  "title": "PcbKnowledge FactRecordV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "fact_type",
    "status",
    "prepared_by",
    "payload",
    "conditions",
    "applicability",
    "evidence_anchors",
    "review_history",
    "review",
    "supersedes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^fact_[0-9a-f]{24,32}$" },
    "fact_type": { "enum": ["COMPONENT_PIN", "PARAMETER_LIMIT"] },
    "status": {
      "enum": ["DRAFT", "READY_FOR_REVIEW", "APPROVED", "REJECTED"]
    },
    "prepared_by": { "enum": ["HUMAN", "AGENT"] },
    "payload": { "type": "object" },
    "conditions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "applicability": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "evidence_anchors": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceAnchor" }
    },
    "review_history": {
      "type": "array",
      "items": { "$ref": "#/$defs/reviewEvent" }
    },
    "review": { "$ref": "#/$defs/review" },
    "supersedes": {
      "type": ["string", "null"],
      "pattern": "^fact_[0-9a-f]{24,32}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "fact_type": { "const": "COMPONENT_PIN" } },
        "required": ["fact_type"]
      },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/componentPinPayload" } }
      }
    },
    {
      "if": {
        "properties": { "fact_type": { "const": "PARAMETER_LIMIT" } },
        "required": ["fact_type"]
      },
      "then": {
        "properties": { "payload": { "$ref": "#/$defs/parameterLimitPayload" } }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "APPROVED" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "evidence_anchors": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/completeEvidenceAnchor" }
          }
        }
      }
    }
  ],
  "$defs": {
    "componentPinPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "package_id",
        "pin_number",
        "pin_name",
        "primary_function",
        "alternate_functions"
      ],
      "properties": {
        "component_id": {
          "type": "string",
          "pattern": "^ent_[0-9a-f]{24,32}$"
        },
        "package_id": {
          "type": "string",
          "pattern": "^ent_[0-9a-f]{24,32}$"
        },
        "pin_number": { "type": "string", "minLength": 1, "maxLength": 100 },
        "pin_name": { "type": ["string", "null"], "minLength": 1, "maxLength": 200 },
        "primary_function": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "alternate_functions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "parameterLimitPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "parameter",
        "limit_kind",
        "minimum",
        "typical",
        "maximum",
        "unit"
      ],
      "properties": {
        "component_id": {
          "type": "string",
          "pattern": "^ent_[0-9a-f]{24,32}$"
        },
        "parameter": { "type": "string", "minLength": 1, "maxLength": 300 },
        "limit_kind": {
          "enum": [
            "ABSOLUTE_MAXIMUM",
            "RECOMMENDED_OPERATING",
            "ELECTRICAL_CHARACTERISTIC"
          ]
        },
        "minimum": { "type": ["number", "null"] },
        "typical": { "type": ["number", "null"] },
        "maximum": { "type": ["number", "null"] },
        "unit": { "type": "string", "minLength": 1, "maxLength": 100 }
      },
      "anyOf": [
        { "properties": { "minimum": { "type": "number" } } },
        { "properties": { "typical": { "type": "number" } } },
        { "properties": { "maximum": { "type": "number" } } }
      ]
    },
    "evidenceAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "page",
        "coordinate_space",
        "bbox",
        "quote",
        "quote_sha256"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^pk_[0-9a-f]{24,32}$"
        },
        "page": { "type": "integer", "minimum": 1 },
        "coordinate_space": { "const": "PDF_NORMALIZED_V1" },
        "bbox": {
          "type": ["array", "null"],
          "prefixItems": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 }
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "quote": { "type": ["string", "null"], "minLength": 1, "maxLength": 8000 },
        "quote_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "completeEvidenceAnchor": {
      "allOf": [
        { "$ref": "#/$defs/evidenceAnchor" },
        {
          "properties": {
            "bbox": { "type": "array" },
            "quote": { "type": "string", "minLength": 1 },
            "quote_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "reviewEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "comment"],
      "properties": {
        "action": { "enum": ["SUBMITTED", "APPROVED", "REJECTED"] },
        "comment": { "type": ["string", "null"], "minLength": 1, "maxLength": 4000 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "comment"],
      "properties": {
        "decision": { "enum": ["APPROVED", "REJECTED", null] },
        "comment": { "type": ["string", "null"], "minLength": 1, "maxLength": 4000 }
      }
    }
  }
}
