{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layout-constraint.schema.json",
  "type": "object",
  "properties": {
    "branches": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "$ref": "evidence.schema.json"
          },
          "sense": {
            "minLength": 1,
            "type": "string"
          },
          "target": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "sense",
          "target",
          "evidence"
        ],
        "type": "object"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "max_distance": {
      "oneOf": [
        {
          "$ref": "quantity.schema.json"
        },
        {
          "$ref": "unknown.schema.json"
        }
      ]
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "path": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 3
    },
    "max_area": {
      "oneOf": [
        {
          "$ref": "quantity.schema.json"
        },
        {
          "$ref": "unknown.schema.json"
        }
      ]
    },
    "sense_nets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "net": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "min_width": {
      "oneOf": [
        {
          "$ref": "quantity.schema.json"
        },
        {
          "$ref": "unknown.schema.json"
        }
      ]
    },
    "min_clearance": {
      "oneOf": [
        {
          "$ref": "quantity.schema.json"
        },
        {
          "$ref": "unknown.schema.json"
        }
      ]
    },
    "margin": {
      "oneOf": [
        {
          "$ref": "quantity.schema.json"
        },
        {
          "$ref": "unknown.schema.json"
        }
      ]
    },
    "min_area": {
      "oneOf": [
        {
          "$ref": "quantity.schema.json"
        },
        {
          "$ref": "unknown.schema.json"
        }
      ]
    },
    "edge": {
      "enum": [
        "TOP",
        "BOTTOM",
        "LEFT",
        "RIGHT"
      ]
    },
    "angle": {
      "oneOf": [
        {
          "$ref": "quantity.schema.json"
        },
        {
          "$ref": "unknown.schema.json"
        }
      ]
    },
    "distance": {
      "$ref": "quantity.schema.json"
    },
    "nets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "gap": {
      "oneOf": [
        {
          "$ref": "quantity.schema.json"
        },
        {
          "$ref": "unknown.schema.json"
        }
      ]
    },
    "max_skew": {
      "oneOf": [
        {
          "$ref": "quantity.schema.json"
        },
        {
          "$ref": "unknown.schema.json"
        }
      ]
    },
    "guard_net": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "return_net": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "kind"
  ],
  "additionalProperties": false
}
