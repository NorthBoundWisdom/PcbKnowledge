{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layout-constraint.schema.json",
  "type": "object",
  "properties": {
    "branches": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "$ref": "evidence.schema.json"
          },
          "sense": {
            "minLength": 1,
            "type": "string"
          },
          "target": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "sense",
          "target",
          "evidence"
        ],
        "type": "object"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "max_distance": {
      "oneOf": [
        {
          "$ref": "quantity.schema.json"
        },
        {
          "$ref": "unknown.schema.json"
        }
      ]
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "path": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 3
    },
    "max_area": {
      "oneOf": [
        {
          "$ref": "quantity.schema.json"
        },
        {
          "$ref": "unknown.schema.json"
        }
      ]
    },
    "sense_nets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "net": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "min_width": {
      "oneOf": [
        {
          "$ref": "quantity.schema.json"
        },
        {
          "$ref": "unknown.schema.json"
        }
      ]
    },
    "min_clearance": {
      "oneOf": [
        {
          "$ref": "quantity.schema.json"
        },
        {
          "$ref": "unknown.schema.json"
        }
      ]
    },
    "margin": {
      "oneOf": [
        {
          "$ref": "quantity.schema.json"
        },
        {
          "$ref": "unknown.schema.json"
        }
      ]
    },
    "min_area": {
      "oneOf": [
        {
          "$ref": "quantity.schema.json"
        },
        {
          "$ref": "unknown.schema.json"
        }
      ]
    },
    "edge": {
      "enum": [
        "TOP",
        "BOTTOM",
        "LEFT",
        "RIGHT"
      ]
    },
    "angle": {
      "oneOf": [
        {
          "$ref": "quantity.schema.json"
        },
        {
          "$ref": "unknown.schema.json"
        }
      ]
    },
    "distance": {
      "$ref": "quantity.schema.json"
    },
    "nets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "gap": {
      "oneOf": [
        {
          "$ref": "quantity.schema.json"
        },
        {
          "$ref": "unknown.schema.json"
        }
      ]
    },
    "max_skew": {
      "oneOf": [
        {
          "$ref": "quantity.schema.json"
        },
        {
          "$ref": "unknown.schema.json"
        }
      ]
    },
    "guard_net": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "return_net": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "region": {
      "$ref": "#/$defs/conductor_keepout"
    }
  },
  "required": [
    "kind"
  ],
  "additionalProperties": false,
  "$defs": {
    "conductor_keepout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "maxLength": 64
        },
        "rectangle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "xmin": {
              "$ref": "quantity.schema.json"
            },
            "ymin": {
              "$ref": "quantity.schema.json"
            },
            "xmax": {
              "$ref": "quantity.schema.json"
            },
            "ymax": {
              "$ref": "quantity.schema.json"
            }
          },
          "required": [
            "xmin",
            "ymin",
            "xmax",
            "ymax"
          ]
        },
        "forbid": {
          "type": "array",
          "items": {
            "enum": [
              "TRACK",
              "VIA"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "layer_scope": {
          "const": "ALL_COPPER"
        },
        "scope_basis": {
          "const": "ENGINEERING_DEFAULT"
        },
        "scope_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "evidence": {
          "$ref": "evidence.schema.json"
        }
      },
      "required": [
        "id",
        "rectangle",
        "forbid",
        "layer_scope",
        "scope_basis",
        "scope_note",
        "evidence"
      ]
    }
  }
}
