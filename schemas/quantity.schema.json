{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quantity.schema.json",
  "type": "object",
  "properties": {
    "value": {
      "type": "number"
    },
    "min": {
      "type": "number"
    },
    "typ": {
      "type": "number"
    },
    "max": {
      "type": "number"
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "conditions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "value",
          "unit"
        ],
        "additionalProperties": false
      }
    },
    "basis": {
      "enum": [
        "DATASHEET",
        "STANDARD_CONVENTION",
        "ENGINEERING_DEFAULT",
        "CALCULATED"
      ]
    },
    "evidence": {
      "$ref": "evidence.schema.json"
    },
    "convention": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "calculator": {
      "enum": [
        "ldo_headroom",
        "ldo_dissipation",
        "led_resistor",
        "i2c_pullup",
        "shunt_resistor",
        "trace_width",
        "oscillator_startup",
        "buck_inductor_ripple",
        "buck_output_ripple",
        "mosfet_conduction_loss",
        "rc_time",
        "darlington_driver",
        "gpio_drive",
        "feedback_divider",
        "feedback_parallel_divider",
        "tps5430_filter",
        "tps5430_ccm_design",
        "ntc_divider",
        "ferrite_loss",
        "tia_frontend",
        "tia_loop_model",
        "opamp_gain",
        "rc_filter",
        "reference_load",
        "rs485_termination",
        "trace_impedance_microstrip",
        "tps5430_output_ripple",
        "input_protection"
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "quantity.schema.json"
      },
      "minProperties": 1
    }
  },
  "required": [
    "unit",
    "conditions",
    "basis"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "oneOf": [
        {
          "required": [
            "value"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "min"
                ]
              },
              {
                "required": [
                  "typ"
                ]
              },
              {
                "required": [
                  "max"
                ]
              }
            ]
          }
        },
        {
          "anyOf": [
            {
              "required": [
                "min"
              ]
            },
            {
              "required": [
                "typ"
              ]
            },
            {
              "required": [
                "max"
              ]
            }
          ],
          "not": {
            "required": [
              "value"
            ]
          }
        }
      ]
    },
    {
      "oneOf": [
        {
          "properties": {
            "basis": {
              "const": "DATASHEET"
            }
          },
          "required": [
            "evidence"
          ]
        },
        {
          "properties": {
            "basis": {
              "const": "STANDARD_CONVENTION"
            }
          },
          "required": [
            "convention"
          ]
        },
        {
          "properties": {
            "basis": {
              "const": "ENGINEERING_DEFAULT"
            }
          },
          "required": [
            "note"
          ]
        },
        {
          "properties": {
            "basis": {
              "const": "CALCULATED"
            }
          },
          "required": [
            "calculator",
            "inputs"
          ]
        }
      ]
    }
  ],
  "$defs": {
    "unconstrained": {
      "type": "object",
      "properties": {
        "status": {
          "const": "UNCONSTRAINED"
        },
        "basis": {
          "const": "ENGINEERING_DEFAULT"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "status",
        "basis",
        "note"
      ],
      "additionalProperties": false
    }
  }
}
