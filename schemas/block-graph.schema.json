{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "block-graph.schema.json",
  "title": "Planned block graph input",
  "type": "object",
  "properties": {
    "schema": {
      "const": "pcbknowledge.block-graph.v2"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "brief": {
      "enum": [
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G1V1",
        "G1V2",
        "N1",
        "N2",
        "N3",
        "N4",
        "T1",
        "T2",
        "T3",
        "T4",
        "T5",
        "T6",
        "T7",
        "T8",
        "T9",
        "T10",
        "N5",
        "N6",
        "N7",
        "N8",
        "N9"
      ]
    },
    "status": {
      "const": "DRAFT"
    },
    "interface_status": {
      "const": "PLANNED_BLOCK_CONTRACTS"
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "block": {
            "type": "string",
            "pattern": "^block:[a-z][a-z0-9-]*$"
          },
          "parameters": {
            "$ref": "parameters.schema.json"
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "name",
                "type"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "block",
          "parameters",
          "ports",
          "requirements"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "net": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "instance": {
                  "type": "string",
                  "minLength": 1
                },
                "port": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "instance",
                "port"
              ],
              "additionalProperties": false
            },
            "minItems": 2
          }
        },
        "required": [
          "net",
          "endpoints"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "pin_configurations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "instance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "port": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "mode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "initial_state": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "instance",
          "port",
          "mode",
          "initial_state"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "port_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "instance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "port": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "function": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "instance",
          "port",
          "function"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "bringup": {
      "$ref": "design-intent.schema.json#/$defs/bringup"
    }
  },
  "required": [
    "schema",
    "id",
    "brief",
    "status",
    "interface_status",
    "instances",
    "connections",
    "requirements"
  ],
  "additionalProperties": false
}
