{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "block.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "pcbknowledge.block.v2"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^block:[a-z0-9][a-z0-9/_-]*$"
    },
    "verification": {
      "$ref": "envelope.schema.json#/$defs/verification"
    },
    "provenance": {
      "$ref": "envelope.schema.json#/$defs/provenance"
    },
    "category": {
      "enum": [
        "power.input",
        "power.protection",
        "power.linear",
        "digital.mcu",
        "digital.debug",
        "ui.indicator",
        "ui.button",
        "bus.i2c",
        "sensor.current",
        "memory.eeprom",
        "interface.header",
        "mechanical.mounting",
        "sensor.temperature",
        "interface.usb-uart",
        "power.switch",
        "driver.relay",
        "power.switching",
        "power.reference",
        "sensor.adc",
        "interface.rs485",
        "sensor.photodiode",
        "power.filter"
      ]
    },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "required": {
            "type": "boolean"
          },
          "fixed": {
            "$ref": "quantity.schema.json"
          }
        },
        "required": [
          "quantity",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "required_function": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "name",
          "kind"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "select": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "part": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^part:[a-z0-9][a-z0-9/_-]*$"
                  }
                },
                "required": [
                  "part"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "match": {
                    "$ref": "parameters.schema.json"
                  }
                },
                "required": [
                  "role",
                  "match"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "ref",
          "select"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "nets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "connect": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "minItems": 2,
            "uniqueItems": true
          }
        },
        "required": [
          "name",
          "connect"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "calculator": {
            "enum": [
              "ldo_headroom",
              "ldo_dissipation",
              "led_resistor",
              "i2c_pullup",
              "shunt_resistor",
              "trace_width",
              "oscillator_startup",
              "buck_inductor_ripple",
              "buck_output_ripple",
              "mosfet_conduction_loss",
              "rc_time",
              "darlington_driver",
              "gpio_drive",
              "feedback_divider",
              "feedback_parallel_divider",
              "tps5430_filter",
              "tps5430_ccm_design",
              "ntc_divider",
              "ferrite_loss",
              "tia_frontend",
              "tia_loop_model",
              "opamp_gain",
              "rc_filter",
              "reference_load",
              "rs485_termination",
              "trace_impedance_microstrip",
              "tps5430_output_ripple",
              "input_protection",
              "tia_loop_total_capacitance",
              "dac_feedback_injection",
              "supervisor_divider_threshold",
              "monitor_input_load",
              "control_rail_budget",
              "fccm_buck_with_local_loads",
              "output_shunt_budget",
              "spi_dac_schedule",
              "passive_supply_path",
              "dual_parallel_capacitance",
              "quad_parallel_capacitance",
              "triple_resistor_load_with_base",
              "four_preload_four_consumer_budget",
              "sampled_waveform_envelope",
              "single_resistor_load",
              "dual_resistor_load"
            ]
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "oneOf": [
                    {
                      "$ref": "quantity.schema.json"
                    },
                    {
                      "$ref": "unknown.schema.json"
                    }
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "parameter": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "parameter"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "component": {
                      "type": "string",
                      "minLength": 1
                    },
                    "parameter": {
                      "type": "string",
                      "minLength": 1
                    },
                    "bound": {
                      "enum": [
                        "min",
                        "max",
                        "value"
                      ]
                    }
                  },
                  "required": [
                    "component",
                    "parameter"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "require": {
            "type": "object",
            "properties": {
              "output": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "operator": {
                "enum": [
                  "LE",
                  "GE"
                ]
              },
              "limit": {
                "oneOf": [
                  {
                    "$ref": "quantity.schema.json"
                  },
                  {
                    "$ref": "unknown.schema.json"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "parameter": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    },
                    "required": [
                      "parameter"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "output",
              "operator",
              "limit"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "calculator",
          "inputs",
          "require"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "layout": {
      "type": "array",
      "items": {
        "$ref": "layout-constraint.schema.json"
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      },
      "minItems": 0
    },
    "external_loads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "connector": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "supply_pin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "return_pin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "connector",
          "supply_pin",
          "return_pin"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "id",
    "verification",
    "provenance",
    "category",
    "parameters",
    "ports",
    "components",
    "nets",
    "checks",
    "layout",
    "evidence"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "verification": {
              "const": "DRAFT"
            }
          }
        },
        {
          "properties": {
            "verification": {
              "enum": [
                "AGENT_VERIFIED",
                "HUMAN_VERIFIED"
              ]
            },
            "provenance": {
              "properties": {
                "verified_by": {
                  "minItems": 1
                }
              }
            }
          }
        }
      ]
    },
    {
      "oneOf": [
        {
          "properties": {
            "category": {
              "const": "mechanical.mounting"
            },
            "ports": {
              "maxItems": 0
            },
            "nets": {
              "maxItems": 0
            }
          }
        },
        {
          "properties": {
            "category": {
              "not": {
                "const": "mechanical.mounting"
              }
            },
            "ports": {
              "minItems": 1
            },
            "nets": {
              "minItems": 1
            }
          }
        }
      ]
    }
  ]
}
