{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-intent.schema.json",
  "type": "object",
  "properties": {
    "schema": {"const": "pcbknowledge.design_intent.v2"},
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "brief_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "bundle_commit": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[0-9a-f]{40}$"},
    "block_graph_sha256": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[0-9a-f]{64}$"},
    "status": {
      "enum": ["EXPANDED", "REFUSED"]
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {"type": "string", "minLength": 1, "maxLength": 256},
          "part": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^part:[a-z0-9][a-z0-9/_-]*$"},
          "package": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^package:[a-z0-9][a-z0-9/_-]*$"},
          "footprint": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "required": ["ref", "part", "package", "footprint"],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "nets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 256},
          "pins": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ref": {"type": "string", "minLength": 1, "maxLength": 256},
                "pin": {"type": "string", "minLength": 1, "maxLength": 256}
              },
              "required": ["ref", "pin"],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "class": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "required": ["name", "pins", "class"],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "bom": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^part:[a-z0-9][a-z0-9/_-]*$"},
          "refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1, "maxLength": 256},
            "minItems": 1,
            "uniqueItems": true
          },
          "quantity": {"type": "integer", "minimum": 1}
        },
        "required": ["part", "refs", "quantity"],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "layout": {
      "type": "array",
      "items": {"$ref": "layout-constraint.schema.json"},
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 256},
          "result": {
            "enum": ["PASS", "FAIL", "UNKNOWN"]
          },
          "reason": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "required": ["id", "result"],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "verification": {
      "enum": ["DRAFT", "AGENT_VERIFIED", "HUMAN_VERIFIED"]
    },
    "refusals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "enum": [
              "UNKNOWN_INPUT",
              "MISSING_RECORD",
              "UNVERIFIED_RECORD",
              "UNSATISFIED_SELECTION",
              "UNCONNECTED_PIN",
              "CHECK_FAILED",
              "INVALID_REFERENCE"
            ]
          },
          "path": {"type": "string", "minLength": 1, "maxLength": 256},
          "reason": {"type": "string", "minLength": 1, "maxLength": 256},
          "queries": {
            "type": "array",
            "items": {
              "enum": ["Q1", "Q2", "Q3", "Q4", "Q5", "Q6", "Q7", "Q8", "Q9", "Q10", "Q11", "Q12"]
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": ["code", "path", "reason", "queries"],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "evidence.schema.json"},
      "minItems": 0
    },
    "fab_profile": {
      "oneOf": [
        {"type": "string", "pattern": "^fab_profile:[a-z0-9][a-z0-9/_-]*$", "maxLength": 256},
        {"$ref": "unknown.schema.json"}
      ]
    },
    "mechanical": {
      "type": "object",
      "properties": {
        "outline_envelope": {
          "type": "object",
          "properties": {
            "shape": {"const": "RECTANGLE"},
            "max_length": {
              "oneOf": [
                {
                  "allOf": [
                    {"$ref": "quantity.schema.json"},
                    {
                      "properties": {
                        "unit": {"const": "mm"}
                      }
                    }
                  ]
                },
                {"$ref": "unknown.schema.json"}
              ]
            },
            "max_width": {
              "oneOf": [
                {
                  "allOf": [
                    {"$ref": "quantity.schema.json"},
                    {
                      "properties": {
                        "unit": {"const": "mm"}
                      }
                    }
                  ]
                },
                {"$ref": "unknown.schema.json"}
              ]
            }
          },
          "required": ["shape", "max_length", "max_width"],
          "additionalProperties": false
        },
        "height_limit": {
          "oneOf": [
            {
              "allOf": [
                {"$ref": "quantity.schema.json"},
                {
                  "properties": {
                    "unit": {"const": "mm"}
                  }
                }
              ]
            },
            {"$ref": "unknown.schema.json"}
          ]
        },
        "mounting": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {"type": "string", "minLength": 1, "maxLength": 256},
              "fastener": {"const": "M3"}
            },
            "required": ["ref", "fastener"],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "edge_interfaces": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 256},
          "uniqueItems": true
        }
      },
      "required": ["outline_envelope", "height_limit", "mounting", "edge_interfaces"],
      "additionalProperties": false
    },
    "manufacturing": {
      "type": "object",
      "properties": {
        "layers": {
          "oneOf": [
            {"const": 2},
            {"$ref": "unknown.schema.json"}
          ]
        },
        "thickness": {
          "oneOf": [
            {
              "allOf": [
                {"$ref": "quantity.schema.json"},
                {
                  "properties": {
                    "unit": {"const": "mm"}
                  }
                }
              ]
            },
            {"$ref": "unknown.schema.json"}
          ]
        },
        "copper_requirement": {
          "oneOf": [
            {"const": "ONE_OZ_NOMINAL"},
            {"$ref": "unknown.schema.json"}
          ]
        },
        "assembly_side": {
          "oneOf": [
            {"const": "TOP"},
            {"$ref": "unknown.schema.json"}
          ]
        }
      },
      "required": ["layers", "thickness", "copper_requirement", "assembly_side"],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "id",
    "brief_id",
    "bundle_commit",
    "block_graph_sha256",
    "status",
    "components",
    "nets",
    "bom",
    "layout",
    "checks",
    "verification",
    "refusals",
    "evidence",
    "fab_profile",
    "mechanical",
    "manufacturing"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "status": {"const": "EXPANDED"},
        "components": {"minItems": 1},
        "nets": {"minItems": 1},
        "bom": {"minItems": 1},
        "verification": {
          "enum": ["AGENT_VERIFIED", "HUMAN_VERIFIED"]
        },
        "refusals": {"maxItems": 0},
        "checks": {
          "items": {
            "properties": {
              "result": {"const": "PASS"}
            }
          }
        },
        "fab_profile": {"type": "string", "pattern": "^fab_profile:[a-z0-9][a-z0-9/_-]*$", "maxLength": 256},
        "mechanical": {
          "properties": {
            "outline_envelope": {
              "properties": {
                "max_length": {
                  "allOf": [
                    {"$ref": "quantity.schema.json"},
                    {
                      "properties": {
                        "unit": {"const": "mm"}
                      }
                    }
                  ]
                },
                "max_width": {
                  "allOf": [
                    {"$ref": "quantity.schema.json"},
                    {
                      "properties": {
                        "unit": {"const": "mm"}
                      }
                    }
                  ]
                }
              }
            },
            "height_limit": {
              "allOf": [
                {"$ref": "quantity.schema.json"},
                {
                  "properties": {
                    "unit": {"const": "mm"}
                  }
                }
              ]
            },
            "mounting": {"minItems": 1}
          }
        },
        "manufacturing": {
          "properties": {
            "layers": {"const": 2},
            "thickness": {
              "allOf": [
                {"$ref": "quantity.schema.json"},
                {
                  "properties": {
                    "unit": {"const": "mm"}
                  }
                }
              ]
            },
            "copper_requirement": {"const": "ONE_OZ_NOMINAL"},
            "assembly_side": {"const": "TOP"}
          }
        }
      }
    },
    {
      "properties": {
        "status": {"const": "REFUSED"},
        "refusals": {"minItems": 1}
      }
    }
  ]
}
