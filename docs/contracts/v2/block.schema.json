{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "block.schema.json",
  "type": "object",
  "properties": {
    "schema": {"const": "pcbknowledge.block.v2"},
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^block:[a-z0-9][a-z0-9/_-]*$"},
    "verification": {"$ref": "envelope.schema.json#/$defs/verification"},
    "provenance": {"$ref": "envelope.schema.json#/$defs/provenance"},
    "category": {
      "enum": [
        "power.input",
        "power.protection",
        "power.linear",
        "digital.mcu",
        "digital.debug",
        "ui.indicator",
        "ui.button",
        "bus.i2c",
        "sensor.current",
        "memory.eeprom",
        "interface.header",
        "mechanical.mounting"
      ]
    },
    "parameters": {
      "type": "object",
      "properties": {
        "input_current": {
          "type": "object",
          "properties": {
            "quantity": {"const": "current"},
            "required": {"type": "boolean"}
          },
          "required": ["quantity", "required"],
          "additionalProperties": false
        },
        "input_voltage": {
          "type": "object",
          "properties": {
            "quantity": {"const": "voltage"},
            "required": {"type": "boolean"}
          },
          "required": ["quantity", "required"],
          "additionalProperties": false
        },
        "output_voltage": {
          "type": "object",
          "properties": {
            "quantity": {"const": "voltage"},
            "required": {"type": "boolean"}
          },
          "required": ["quantity", "required"],
          "additionalProperties": false
        },
        "output_current": {
          "type": "object",
          "properties": {
            "quantity": {"const": "current"},
            "required": {"type": "boolean"}
          },
          "required": ["quantity", "required"],
          "additionalProperties": false
        },
        "voltage_rating": {
          "type": "object",
          "properties": {
            "quantity": {"const": "voltage"},
            "required": {"type": "boolean"}
          },
          "required": ["quantity", "required"],
          "additionalProperties": false
        },
        "current_rating": {
          "type": "object",
          "properties": {
            "quantity": {"const": "current"},
            "required": {"type": "boolean"}
          },
          "required": ["quantity", "required"],
          "additionalProperties": false
        },
        "power_rating": {
          "type": "object",
          "properties": {
            "quantity": {"const": "power"},
            "required": {"type": "boolean"}
          },
          "required": ["quantity", "required"],
          "additionalProperties": false
        },
        "capacitance": {
          "type": "object",
          "properties": {
            "quantity": {"const": "capacitance"},
            "required": {"type": "boolean"}
          },
          "required": ["quantity", "required"],
          "additionalProperties": false
        },
        "resistance": {
          "type": "object",
          "properties": {
            "quantity": {"const": "resistance"},
            "required": {"type": "boolean"}
          },
          "required": ["quantity", "required"],
          "additionalProperties": false
        },
        "clock_frequency": {
          "type": "object",
          "properties": {
            "quantity": {"const": "frequency"},
            "required": {"type": "boolean"}
          },
          "required": ["quantity", "required"],
          "additionalProperties": false
        },
        "bus_frequency": {
          "type": "object",
          "properties": {
            "quantity": {"const": "frequency"},
            "required": {"type": "boolean"}
          },
          "required": ["quantity", "required"],
          "additionalProperties": false
        },
        "frequency": {
          "type": "object",
          "properties": {
            "quantity": {"const": "frequency"},
            "required": {"type": "boolean"}
          },
          "required": ["quantity", "required"],
          "additionalProperties": false
        },
        "length": {
          "type": "object",
          "properties": {
            "quantity": {"const": "length"},
            "required": {"type": "boolean"}
          },
          "required": ["quantity", "required"],
          "additionalProperties": false
        },
        "width": {
          "type": "object",
          "properties": {
            "quantity": {"const": "length"},
            "required": {"type": "boolean"}
          },
          "required": ["quantity", "required"],
          "additionalProperties": false
        },
        "height": {
          "type": "object",
          "properties": {
            "quantity": {"const": "length"},
            "required": {"type": "boolean"}
          },
          "required": ["quantity", "required"],
          "additionalProperties": false
        },
        "thickness": {
          "type": "object",
          "properties": {
            "quantity": {"const": "length"},
            "required": {"type": "boolean"}
          },
          "required": ["quantity", "required"],
          "additionalProperties": false
        },
        "pitch": {
          "type": "object",
          "properties": {
            "quantity": {"const": "length"},
            "required": {"type": "boolean"}
          },
          "required": ["quantity", "required"],
          "additionalProperties": false
        },
        "drill": {
          "type": "object",
          "properties": {
            "quantity": {"const": "length"},
            "required": {"type": "boolean"}
          },
          "required": ["quantity", "required"],
          "additionalProperties": false
        },
        "clearance": {
          "type": "object",
          "properties": {
            "quantity": {"const": "length"},
            "required": {"type": "boolean"}
          },
          "required": ["quantity", "required"],
          "additionalProperties": false
        },
        "trace_width": {
          "type": "object",
          "properties": {
            "quantity": {"const": "length"},
            "required": {"type": "boolean"}
          },
          "required": ["quantity", "required"],
          "additionalProperties": false
        },
        "annular_ring": {
          "type": "object",
          "properties": {
            "quantity": {"const": "length"},
            "required": {"type": "boolean"}
          },
          "required": ["quantity", "required"],
          "additionalProperties": false
        },
        "solder_mask_web": {
          "type": "object",
          "properties": {
            "quantity": {"const": "length"},
            "required": {"type": "boolean"}
          },
          "required": ["quantity", "required"],
          "additionalProperties": false
        },
        "copper_thickness": {
          "type": "object",
          "properties": {
            "quantity": {"const": "length"},
            "required": {"type": "boolean"}
          },
          "required": ["quantity", "required"],
          "additionalProperties": false
        },
        "temperature": {
          "type": "object",
          "properties": {
            "quantity": {"const": "temperature"},
            "required": {"type": "boolean"}
          },
          "required": ["quantity", "required"],
          "additionalProperties": false
        },
        "time": {
          "type": "object",
          "properties": {
            "quantity": {"const": "time"},
            "required": {"type": "boolean"}
          },
          "required": ["quantity", "required"],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 256},
          "kind": {
            "enum": [
              "POWER_IN",
              "POWER_OUT",
              "GROUND",
              "INPUT",
              "OUTPUT",
              "BIDIRECTIONAL",
              "OPEN_DRAIN",
              "ANALOG",
              "PASSIVE",
              "NO_CONNECT"
            ]
          }
        },
        "required": ["name", "kind"],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {"type": "string", "minLength": 1, "maxLength": 256},
          "select": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "part": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^part:[a-z0-9][a-z0-9/_-]*$"
                  }
                },
                "required": ["part"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "role": {
                    "enum": [
                      "connector.usb-c-sink",
                      "protection.fuse",
                      "protection.tvs",
                      "diode.schottky",
                      "regulator.linear.fixed",
                      "capacitor.ceramic",
                      "capacitor.bulk",
                      "resistor",
                      "mcu.32-bit",
                      "crystal",
                      "connector.header",
                      "led",
                      "switch.button",
                      "monitor.current",
                      "memory.eeprom",
                      "mechanical.mounting-hole"
                    ]
                  },
                  "match": {"$ref": "parameters.schema.json"}
                },
                "required": ["role", "match"],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": ["ref", "select"],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "nets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 256},
          "connect": {
            "type": "array",
            "items": {"type": "string", "minLength": 1, "maxLength": 256},
            "minItems": 2,
            "uniqueItems": true
          }
        },
        "required": ["name", "connect"],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "calculator": {
            "enum": ["ldo_dissipation", "led_resistor", "i2c_pullup", "ipc2152_width"]
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "oneOf": [
                    {"$ref": "quantity.schema.json"},
                    {"$ref": "unknown.schema.json"}
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "parameter": {
                      "enum": [
                        "input_current",
                        "input_voltage",
                        "output_voltage",
                        "output_current",
                        "voltage_rating",
                        "current_rating",
                        "power_rating",
                        "capacitance",
                        "resistance",
                        "clock_frequency",
                        "bus_frequency",
                        "frequency",
                        "length",
                        "width",
                        "height",
                        "thickness",
                        "pitch",
                        "drill",
                        "clearance",
                        "trace_width",
                        "annular_ring",
                        "solder_mask_web",
                        "copper_thickness",
                        "temperature",
                        "time"
                      ]
                    }
                  },
                  "required": ["parameter"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "require": {
            "type": "object",
            "properties": {
              "output": {"type": "string", "minLength": 1, "maxLength": 256},
              "operator": {
                "enum": ["LE", "GE"]
              },
              "limit": {
                "oneOf": [
                  {"$ref": "quantity.schema.json"},
                  {"$ref": "unknown.schema.json"}
                ]
              }
            },
            "required": ["output", "operator", "limit"],
            "additionalProperties": false
          }
        },
        "required": ["calculator", "inputs", "require"],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "layout": {
      "type": "array",
      "items": {"$ref": "layout-constraint.schema.json"},
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "evidence.schema.json"},
      "minItems": 0
    }
  },
  "required": [
    "schema",
    "id",
    "verification",
    "provenance",
    "category",
    "parameters",
    "ports",
    "components",
    "nets",
    "checks",
    "layout",
    "evidence"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "verification": {"const": "DRAFT"}
          }
        },
        {
          "properties": {
            "verification": {
              "enum": ["AGENT_VERIFIED", "HUMAN_VERIFIED"]
            },
            "provenance": {
              "properties": {
                "verified_by": {"minItems": 1}
              }
            }
          }
        }
      ]
    },
    {
      "oneOf": [
        {
          "properties": {
            "category": {"const": "mechanical.mounting"},
            "ports": {"maxItems": 0},
            "nets": {"maxItems": 0}
          }
        },
        {
          "properties": {
            "category": {
              "not": {"const": "mechanical.mounting"}
            },
            "ports": {"minItems": 1},
            "nets": {"minItems": 1}
          }
        }
      ]
    }
  ]
}
