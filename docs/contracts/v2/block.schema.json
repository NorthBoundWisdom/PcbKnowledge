{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "block.schema.json",
  "type": "object",
  "properties": {
    "schema": {"const": "pcbknowledge.block.v2"},
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^block:[a-z0-9][a-z0-9/_-]*$"},
    "verification": {"$ref": "envelope.schema.json#/$defs/verification"},
    "provenance": {"$ref": "envelope.schema.json#/$defs/provenance"},
    "category": {
      "enum": [
        "power.input",
        "power.protection",
        "power.linear",
        "digital.mcu",
        "digital.debug",
        "ui.indicator",
        "ui.button",
        "bus.i2c",
        "sensor.current",
        "memory.eeprom",
        "interface.header",
        "mechanical.mounting"
      ]
    },
    "parameters": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1, "maxLength": 256},
      "additionalProperties": {
        "type": "object",
        "properties": {"quantity": {"type": "string", "minLength": 1, "maxLength": 256}, "required": {"type": "boolean"}},
        "required": ["quantity", "required"],
        "additionalProperties": false
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 256},
          "kind": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "required": ["name", "kind"],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {"type": "string", "minLength": 1, "maxLength": 256},
          "select": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "part": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^part:[a-z0-9][a-z0-9/_-]*$"
                  }
                },
                "required": ["part"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "role": {"type": "string", "minLength": 1, "maxLength": 256},
                  "match": {"$ref": "parameters.schema.json"}
                },
                "required": ["role", "match"],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": ["ref", "select"],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "nets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 256},
          "connect": {
            "type": "array",
            "items": {"type": "string", "minLength": 1, "maxLength": 256},
            "minItems": 2,
            "uniqueItems": true
          }
        },
        "required": ["name", "connect"],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "calculator": {"enum": ["ldo_dissipation", "led_resistor", "i2c_pullup", "ipc2152_width"]},
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {"oneOf": [{"$ref": "quantity.schema.json"}, {"$ref": "unknown.schema.json"}]},
                {
                  "type": "object",
                  "properties": {"parameter": {"type": "string", "minLength": 1, "maxLength": 256}},
                  "required": ["parameter"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "require": {
            "type": "object",
            "properties": {
              "output": {"type": "string", "minLength": 1, "maxLength": 256},
              "operator": {"enum": ["LE", "GE"]},
              "limit": {"oneOf": [{"$ref": "quantity.schema.json"}, {"$ref": "unknown.schema.json"}]}
            },
            "required": ["output", "operator", "limit"],
            "additionalProperties": false
          }
        },
        "required": ["calculator", "inputs", "require"],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "layout": {"type": "array", "items": {"$ref": "layout-constraint.schema.json"}, "minItems": 0},
    "evidence": {"type": "array", "items": {"$ref": "evidence.schema.json"}, "minItems": 0}
  },
  "required": [
    "schema",
    "id",
    "verification",
    "provenance",
    "category",
    "parameters",
    "ports",
    "components",
    "nets",
    "checks",
    "layout",
    "evidence"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "oneOf": [
        {"properties": {"verification": {"const": "DRAFT"}}},
        {
          "properties": {
            "verification": {"enum": ["AGENT_VERIFIED", "HUMAN_VERIFIED"]},
            "provenance": {"properties": {"verified_by": {"minItems": 1}}}
          }
        }
      ]
    },
    {
      "oneOf": [
        {
          "properties": {"category": {"const": "mechanical.mounting"}, "ports": {"maxItems": 0}, "nets": {"maxItems": 0}}
        },
        {
          "properties": {
            "category": {"not": {"const": "mechanical.mounting"}},
            "ports": {"minItems": 1},
            "nets": {"minItems": 1}
          }
        }
      ]
    }
  ]
}
