{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source.schema.json",
  "type": "object",
  "properties": {
    "schema": {"const": "pcbknowledge.source.v2"},
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^source:[a-z0-9][a-z0-9/_-]*$"},
    "verification": {"$ref": "envelope.schema.json#/$defs/verification"},
    "provenance": {"$ref": "envelope.schema.json#/$defs/provenance"},
    "title": {"type": "string", "minLength": 1, "maxLength": 256},
    "publisher": {"type": "string", "minLength": 1, "maxLength": 256},
    "revision": {"type": "string", "minLength": 1, "maxLength": 256},
    "url": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^https://[^\\s]+$"},
    "accessed_on": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "sha256": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[0-9a-f]{64}$"},
    "bytes": {"type": "integer", "minimum": 1},
    "pages": {"type": "integer", "minimum": 1},
    "license_class": {
      "enum": ["UNKNOWN", "PUBLIC_REFERENCE", "OPEN_LICENSE", "INTERNAL", "RESTRICTED", "LICENSED_BLOCKED_FOR_AI"]
    }
  },
  "required": [
    "schema",
    "id",
    "verification",
    "provenance",
    "title",
    "publisher",
    "revision",
    "url",
    "accessed_on",
    "sha256",
    "bytes",
    "pages",
    "license_class"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "verification": {"const": "DRAFT"}
          }
        },
        {
          "properties": {
            "verification": {
              "enum": ["AGENT_VERIFIED", "HUMAN_VERIFIED"]
            },
            "provenance": {
              "properties": {
                "verified_by": {"minItems": 1}
              }
            }
          }
        }
      ]
    }
  ]
}
