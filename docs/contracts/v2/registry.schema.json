            "required": ["queries"],
            "additionalProperties": false
          },
          "minProperties": 1
        }
      },
      "required": ["schema", "id", "scope", "entries"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": {"const": "pcbknowledge.registry.v2"},
        "id": {"const": "registry:roles"},
        "scope": {"const": "G1"},
