        "schema": {"const": "pcbknowledge.registry.v2"},
        "id": {"const": "registry:package-families"},
        "scope": {"const": "G1"},
        "entries": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "CHIP_0603",
              "SOD-123",
              "SMB",
              "SOT-223",
              "SOIC-8",
              "SOT-23-8",
              "LQFP-48",
              "CRYSTAL_3225",
              "HEADER_2P54",
              "EXPLICIT"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "queries": {
                "type": "array",
                "items": {
                  "enum": ["Q1", "Q2", "Q3", "Q4", "Q5", "Q6", "Q7", "Q8", "Q9", "Q10", "Q11", "Q12"]
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": ["queries"],
            "additionalProperties": false
          },
          "minProperties": 1
        }
      },
      "required": ["schema", "id", "scope", "entries"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": {"const": "pcbknowledge.registry.v2"},
        "id": {"const": "registry:layout-constraints"},
        "scope": {"const": "G1"},
        "entries": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "PLACE_NEAR",
              "GROUP",
              "MINIMIZE_LOOP",
              "KELVIN",
