          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "queries": {
                "type": "array",
                "items": {
                  "enum": ["Q1", "Q2", "Q3", "Q4", "Q5", "Q6", "Q7", "Q8", "Q9", "Q10", "Q11", "Q12"]
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "fields": {
                "type": "array",
                "items": {"type": "string", "minLength": 1, "maxLength": 256},
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": ["queries", "fields"],
            "additionalProperties": false
          },
          "minProperties": 1
        }
      },
      "required": ["schema", "id", "scope", "entries"],
      "additionalProperties": false
    }
