  "constraints": [
    {
      "description": "Control UV, output OV, host reset and held inhibit button prevent buck enable; no firmware-only brownout protection.",
      "id": "t1_hardware_inhibit"
    },
    {
      "description": "Report load voltage/current at10Hz; requested voltage error target<=100mV after calibration and<=5s large-step settling for0..0.5A resistive loads.",
      "id": "t1_measurement"
    },
    {
      "description": "Retain every block constraint and explicit inductor central-strip no-via/no-trace exclusion.",
      "id": "t1_layout"
    },
    {
      "description": "Enforce typed ENGINEERING_DEFAULT operating-envelope.json:35mA control allocation, all output local loads, FCCM signed current and accepted effective-L/f/C/DC error windows. Hardware observations remainNOT_RUN; load must tolerate8V transients, no hardOVP clamp claim.",
      "id": "t1_operating_envelope"
    }
